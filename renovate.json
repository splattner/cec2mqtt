{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeMinor",
    "customManagers:dockerfileVersions",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "labels": [
    "dependencies"
  ],
  "timezone": "Europe/Zurich",
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github-actions"
    },
    {
      "description": "Linters and scanners used in CI.",
      "matchDepNames": [
        "golangci/golangci-lint",
        "golang.org/x/vuln",
        "rhysd/actionlint"
      ],
      "groupName": "ci tools"
    },
    {
      "matchManagers": [
        "dockerfile",
        "custom.regex"
      ],
      "matchFileNames": [
        "Dockerfile"
      ],
      "groupName": "docker base images"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "labels": [
        "dependencies",
        "major"
      ]
    }
  ],
  "customManagers": [
    {
      "description": "Tool versions in the workflows, marked with a '# renovate:' comment (golangci-lint, govulncheck).",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/(workflows|actions)/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+(?:version|[A-Z_]+_VERSION):\\s*[\"']?(?<currentValue>[^\"'\\s]+)"
      ]
    }
  ]
}
